{
  "name": "synapsenotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:remote": "node scripts/dev.mjs --remote",
    "dev:web": "npm run dev -w @synapsenotes/web",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck --workspaces --if-present && npm run lint && npm test",
    "lint": "node scripts/lint.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"apps/server/test/**/*.test.ts\" \"apps/web/test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "db:migrate:local": "npm run db:migrate:local -w @synapsenotes/server",
    "db:migrate:remote": "npm run db:migrate:remote -w @synapsenotes/server",
    "e2e": "npm run e2e -w @synapsenotes/web --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
