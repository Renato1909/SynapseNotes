{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "synapsenotes",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/collab/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synapsenotes-db",
      "database_id": "22cab216-3eed-446f-8309-57f5763cc59e",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTES",
        "class_name": "NoteRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NoteRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1909101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "1909102",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
